{
  "CodeContextOptions": {
    "MaxCalls": 100,
    "MaxSeconds": 60,
    "MaxBytes": 1048576,
    "MaxDegreeOfParallelism": 1,
    "MaxFileSize": 102400,
    "MaxFilesToList": 1000
  },
  "McpConfiguration": {
    "AllowedRoots": {
      "tools": "C:/proyectos/tools",
      "images": "C:/proyectos/images/repo",
      "GHT-Reviews": "C:/GHT/GHT-Reviews"
    },
    "AllowedExtensions": [
      ".cs",
      ".js",
      ".ts",
      ".vb",
      ".html",
      ".css",
      ".scss",
      ".json",
      ".xml",
      ".yaml",
      ".yml",
      ".aspx",
      ".sql"
    ],
    "ExcludedDirectories": [
      "bin",
      "obj",
      ".git",
      ".vs",
      "node_modules",
      "Properties",
      ".config"
    ],
    "ExcludedExtensions": [
      ".dll",
      ".exe",
      ".pdb",
      ".settings.json",
      ".min.js"
    ],
    "ExcludedFiles": [
      "appsettings.json",
      "appsettings.Development.json"
    ]
  }
}